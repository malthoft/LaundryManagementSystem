# JoyOps, contoh variabel lingkungan
# Salin berkas ini jadi .env.local lalu isi nilainya.
# Jangan pernah meng-commit .env.local.

# --- Supabase, wajib ---------------------------------------------------------
# Settings > API di dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RAHASIA. Hanya dipakai di server (pembuatan karyawan dan reset password).
# Jangan pernah dipakai di komponen klien, jangan pernah di-commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Aplikasi ----------------------------------------------------------------
# Domain email sintetis untuk login pakai username.
# username "althof123" menjadi email "althof123@joyops.local".
# Supabase tidak mengirim surat ke domain ini, konfirmasi email tidak dipakai.
AUTH_EMAIL_DOMAIN=joyops.local

NEXT_PUBLIC_APP_NAME=JoyOps

# --- Halaman developer (/developer) ------------------------------------------
# Email dan sandi untuk masuk ke halaman developer. Sandi ini hanya berlaku
# sebagai sandi awal: begitu dipakai masuk, hashnya tersimpan di tabel
# developer_akun dan penggantian berikutnya dilakukan lewat surel.
DEVELOPER_EMAIL=malthof@gmail.com
DEVELOPER_PASSWORD=ganti-dengan-sandi-yang-kuat

# RAHASIA. Penanda tangan sesi developer. Isi dengan nilai acak, misalnya
# hasil dari: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVELOPER_SECRET=ganti-dengan-nilai-acak

# --- Surel (opsional) ---------------------------------------------------------
# Dipakai untuk notifikasi permintaan akun dan tautan atur ulang sandi
# developer. Selama kelima nilai di bawah kosong, aplikasi tetap jalan penuh.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DEVELOPER=malthof@gmail.com

# Alamat publik aplikasi. Dipakai menyusun tautan di dalam surel.
# Kosongkan saja; alamatnya otomatis diambil dari permintaan yang masuk.
NEXT_PUBLIC_SITE_URL=
