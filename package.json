{
  "name": "joyops",
  "version": "3.0.0",
  "private": true,
  "description": "JoyOps, sistem operasional laundry. Next.js + Supabase.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:akun": "node scripts/seed-auth-users.mjs",
    "cek:kontras": "node scripts/cek-kontras.mjs",
    "test": "vitest run",
    "test:detail": "vitest run --reporter=verbose",
    "test:security": "vitest run src/__tests__/security.test.ts --reporter=verbose",
    "test:performance": "vitest run src/__tests__/performance.test.ts --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "jscpd": "jscpd src/"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.5.0",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.12.0",
    "eslint-config-next": "^15.5.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jscpd": "^5.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
